{
  "name": "EURUSD trend follower (FTMO Phase 1)",
  "description": "The walk-forward winner: train +34.10% / test +28.60% / robustness 0.84. Ships as the seed forkable template under Firm Mode = ftmo. Mirrors `backtest/bar_replay/strategy.py::run_trend_follower` math-for-math so the same params drive both backtest and the cAlgo cBot the customer runs.",
  "version": 1,
  "tags": ["trend", "h1", "forex", "seed-template"],
  "instruments": [{"symbol": "EURUSD", "timeframe": "h1"}],
  "indicators": [
    {"id": "sma_fast", "type": "sma", "period": 9},
    {"id": "ema_slow", "type": "ema", "period": 21},
    {"id": "adx",      "type": "adx", "period": 14},
    {"id": "atr",      "type": "atr", "period": 14}
  ],
  "entries": [
    {"side": "long",  "when": "sma_fast crosses_above ema_slow AND adx > 20"},
    {"side": "short", "when": "sma_fast crosses_below ema_slow AND adx > 20"}
  ],
  "exits": [
    {"type": "stop_loss",  "spec": {"atr_mult": 1.5}},
    {"type": "partial_tp", "at_r": 1.0, "fraction": 0.5},
    {"type": "trailing",   "step_r": 0.5}
  ],
  "sizing": {"risk_per_trade_pct": 0.005},
  "guards": {
    "firm_rules": "ftmo",
    "block_news_minutes": 0,
    "no_weekend_hold": false,
    "max_open_positions": 1
  }
}
